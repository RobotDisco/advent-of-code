{ #category : #stars }
AOC2015Day01 class >> star1 [

	"solve star1 using pre-supplied input string INPUT"

	^ self star1WithInput: INPUT
]

{ #category : #stars }
AOC2015Day01 class >> star1WithInput: input [

	"Calculate Santa's final floor after processing all input instructions.
	
	The format of the string `input` is as follows:
	An open parenthesis '(' means Santa goes up one floor.
	A closed parenthesis ')' means Santa goes down one floor.
	Santa starts on floor 0, the ground floor.
	
	The number of the floor is returned after all character in the strings is processed. A negative floor number indicates that we have entered the basement."

	| currentFloor actions |
	currentFloor := 0.
	actions := Dictionary new
		           at: $( put: [ currentFloor := currentFloor + 1 ];
		           at: $) put: [ currentFloor := currentFloor - 1 ];
		           yourself.

	input do: [ :char | (actions at: char) value ].

	^ currentFloor
]

{ #category : #stars }
AOC2015Day01 class >> star2 [

	"solve star1 using pre-supplied input string INPUT"

	^ self star2WithInput: INPUT
]

{ #category : #stars }
AOC2015Day01 class >> star2WithInput: input [

	"Calculate the number of steps it takes Santa to enter the basement based on the input.
	
	The format of the string `input` is as follows:
	An open parenthesis '(' means Santa goes up one floor.
	A closed parenthesis ')' means Santa goes down one floor.
	Santa starts on floor 0, the ground floor.
	A negative floor number indicates that we have entered the basement.
	
	Returns the position in the string where santa first went to a negative floor number."

	| currentFloor steps actions |
	currentFloor := 0.
	steps := 0.
	actions := Dictionary new
		           at: $( put: [ 
			           currentFloor := currentFloor + 1.
			           steps := steps + 1 ];
		           at: $) put: [ 
			           currentFloor := currentFloor - 1.
			           steps := steps + 1 ];
		           yourself.

	input do: [ :char | 
		(actions at: char) value.

		currentFloor < 0 ifTrue: [ ^ steps ] ]
]
